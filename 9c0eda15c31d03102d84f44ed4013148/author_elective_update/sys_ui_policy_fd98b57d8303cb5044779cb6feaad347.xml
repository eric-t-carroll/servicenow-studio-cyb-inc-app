        <script_true><![CDATA[function onCondition() {
	var assessmentSLA = g_form.getValue('notification_sla_status');
	if (assessmentSLA === 'at_risk') {
		g_form.getControl('notification_sla_status').style.backgroundColor = 'yellow';
	} else if (assessmentSLA === 'breached') {
		g_form.getControl('impact').style.backgroundColor = 'red';
	} else if (assessmentSLA === 'assessment_complete') {
		g_form.getControl('impact').style.backgroundColor = 'green';
	} else {
		g_form.getControl('notification_sla_status').style.backgroundColor = '';
	}
}]]></script_true>
