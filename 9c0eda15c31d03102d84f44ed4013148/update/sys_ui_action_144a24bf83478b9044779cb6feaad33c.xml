        <script><![CDATA[function reinvestigate() {
    var dialog = new GlideModal('glide_confirm_standard', true, 600);
    dialog.setTitle('Confirm re-investigation');
    dialog.setPreference('title', 'Are you sure you want to revert the state to Investigation & Diagnosis?');
    dialog.setPreference('onPromptComplete', function() {
        gsftSubmit(null, g_form.getFormElement(), 'reinvestigate');
    });
    dialog.setPreference('onPromptCancel', function() {
        return false;
    });
    dialog.render();
}

if (typeof window == 'undefined') {
	callback();
}

//set resolution code to false positive and change state to Resolved
function callback() {
    current.setValue('state', '11');
	current.work_notes = 'Re-investigation required.';
    current.update();
    action.setRedirectURL(current);
}]]></script>
