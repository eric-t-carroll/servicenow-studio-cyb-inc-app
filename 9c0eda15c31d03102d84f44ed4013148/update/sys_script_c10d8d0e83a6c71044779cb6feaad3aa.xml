        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	//check for valid existing extortion REG task
	var existingReg = new GlideRecord('x_1776078_cyber_0_regulatory_notification_task');
	existingReg.addQuery('parent_cyber_incident', current.sys_id);
	existingReg.addQuery('notification_type', 'ransomware_payment_report');
	var existingRegOr = existingReg.addQuery('state', '-5');
	existingRegOr.addOrCondition('state', '1');
	existingRegOr.addOrCondition('state', '2');
	existingRegOr.addOrCondition('state', '5');
	existingReg.setLimit(1);
	existingReg.query();

	//if REG exists update it with notes about extortion no longer applying
	if (existingReg.next()) {
		existingReg.work_notes = 'Ransom/Extortion Payment Made has been unticked on ' + current.getValue('number') + ' - review if task is still required.';
		existingReg.update();
	}

})(current, previous);]]></script>
