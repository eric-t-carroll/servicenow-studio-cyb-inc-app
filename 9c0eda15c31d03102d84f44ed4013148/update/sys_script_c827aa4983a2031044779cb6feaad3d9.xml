        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
	//let client know a soci notification is required
    g_scratchpad.soci_notification_required = true;

	//search for existing REG tasks already created
    var grReg = new GlideRecord('x_1776078_cyber_0_regulatory_notification_task');
    grReg.addQuery('parent_cyber_incident', current.sys_id);
    grReg.addQuery('notification_type', 'asd_soci_notification');
    grReg.setLimit(1);
    grReg.query();

	//if REG exist, let client know including the task state
    if (grReg.next()) {
        g_scratchpad.soci_task_exists = true;
        g_scratchpad.soci_task_state = grReg.getValue('state');

	//else let client know there is no existing REG task
    } else {
        g_scratchpad.soci_task_exists = false;
    }

})(current, previous);]]></script>
